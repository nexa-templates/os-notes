{
  "name": "@nexa-os-templates/notes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test tests/access.test.mjs && npm run build && node scripts/test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-code-block-lowlight": "3.32.2",
    "@tiptap/extension-highlight": "3.32.2",
    "@tiptap/extension-table": "3.32.2",
    "@tiptap/extension-task-item": "3.32.2",
    "@tiptap/extension-task-list": "3.32.2",
    "@tiptap/markdown": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "dompurify": "3.4.17",
    "lowlight": "3.3.0",
    "marked": "18.1.2",
    "solid-js": "1.9.18",
    "@kobalte/core": "0.13.13"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright-core": "1.58.2",
    "wrangler": "4.156.1",
    "@babel/core": "7.29.7",
    "babel-preset-solid": "1.9.16"
  },
  "cloudflare": {
    "label": "Notes",
    "bindings": {
      "ACCESS_ISSUER": {
        "description": "Cloudflare Access team URL"
      },
      "ACCESS_AUD": {
        "description": "Access application audience"
      },
      "APP_ORIGIN": {
        "description": "Application HTTPS origin"
      }
    }
  }
}
