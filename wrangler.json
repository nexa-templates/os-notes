{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexa-os-notes",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "vars": {
    "PREVIEW_MODE": "false",
    "ACCESS_ISSUER": "",
    "ACCESS_AUD": "",
    "APP_ORIGIN": "",
    "ACCESS_PATHS": "/"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "NOTEBOOKS",
        "class_name": "Notebook"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Notebook"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "CREATION_LIMIT",
      "namespace_id": "8672101",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "preview_urls": false
}
